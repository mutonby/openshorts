# ─────────────────────────────────────────────────────────────────────────────
# OpenShorts+ — ZERO-BUDGET EDITION
#
# The whole AI pipeline runs on FREE providers. Set at least ONE of the keys
# below and the gateway (ai_gateway.py) does the rest, with automatic fallback
# across every provider you configure — if one is rate-limited or out of
# quota, the next one answers.
#
# No billing, no plans, no watermark, no limits. Ever.
#
# NOTE: you don't have to set these as env vars at all! After deploying, open
# the app → Settings → "Free AI keys (server)" and paste keys there — saved on
# the server, works from any device (phone included), no env edits needed.
# Env vars here still work the same way (UI-set keys take precedence).
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# FREE AI PROVIDERS (pick any — more = more resilience)
# ═══════════════════════════════════════════════════════════════════════════

# OpenRouter — dozens of :free models (DeepSeek, Qwen, GLM, Kimi, Gemma,
# gpt-oss, Nemotron...). Free to create an account, no credits needed for
# :free models. THE easiest single key to set.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio — Gemini free tier (gemini-2.5-flash etc.), generous daily
# rate limits. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — llama-3.3-70b / llama-3.1-8b, very generous free tier, fast.
# https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek — deepseek-chat / deepseek-reasoner. New accounts get free credits;
# pricing is already the cheapest around. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Zhipu AI (GLM) — glm-4.5-air / glm-4-flash free tier. https://open.bigmodel.cn
ZHIPU_API_KEY=

# Alibaba Qwen — qwen-plus / qwen-turbo via DashScope compatible-mode; new
# accounts get free quota. https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=

# Moonshot AI (Kimi) — kimi-k2 / moonshot-v1 with free tier quota.
# https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Any OpenAI-compatible endpoint (AgentRouter, token routers, LiteLLM proxy,
# local vLLM/llama.cpp...). Leave OPENAI_API_BASE empty to skip.
# OPENAI_API_BASE=https://your-router.example.com/v1
# OPENAI_API_KEY=your_router_key_here

# ─────────────────────────────────────────────────────────────────────────────
# MODEL ROUTING (optional — sane free defaults are built in)
# ─────────────────────────────────────────────────────────────────────────────

# Ordered fallback chain: "provider:model" entries, tried in order. Only
# providers with a key set are used. Models rotate on free tiers, so override
# when one is retired.
# AI_MODEL_CHAIN=openrouter:openai/gpt-oss-20b:free,openrouter:google/gemma-4-31b-it:free,openrouter:qwen/qwen3-32b:free,groq:llama-3.3-70b-versatile,zhipu:glm-4.5-air,deepseek:deepseek-chat,dashscope:qwen-plus

# Vision tasks (layout picking, silent-video clip detection, AI effects):
# AI_VISION_MODEL_CHAIN=openrouter:google/gemma-4-31b-it:free,openrouter:nvidia/nemotron-nano-12b-v2-vl:free,google:gemini-2.5-flash

# Free image generation (thumbnails, AI Shorts actors/b-roll). Falls back to
# local typographic rendering when unavailable.
# AI_IMAGE_MODEL=openrouter:google/gemini-2.5-flash-image

# Free voiceover voice (Microsoft Edge TTS). Full list:
# https://github.com/rany2/edge-tts (search: edge-tts --list-voices)
# EDGE_TTS_VOICE=en-US-JennyNeural

# Default caption theme burned into every new clip. One of: tiktok, reels,
# shorts, gold, neon, cyber, karaoke, minimal, beast, boxed, classic.
# "auto" (default) uses the app's signature look. Can also be set from the
# dashboard Settings page (stored server-side).
# CAPTION_THEME=neon

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL PAID INTEGRATIONS (bring-your-own — never required)
# ═══════════════════════════════════════════════════════════════════════════
# Without these the app still works: AI Shorts falls back to free image
# generation + Edge TTS + Ken Burns motion; publishing needs Upload-Post.
# ELEVENLABS_API_KEY=
# FAL_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 (optional — for clip backup/gallery)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# ─────────────────────────────────────────────────────────────────────────────
# VIDEO PIPELINE
# ─────────────────────────────────────────────────────────────────────────────
# Upload ceiling in MB (server safety valve, not a paywall).
# MAX_FILE_SIZE_MB=8192

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# FFMPEG_ENCODER=x264

# Product analytics (optional, off by default). Set to your own OpenPanel
# instance to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# ─────────────────────────────────────────────────────────────────────────────
# AI GATEWAY BEHAVIOUR
# ─────────────────────────────────────────────────────────────────────────────
# Auto-fetch OpenRouter's catalog and use ONLY free models (paid are never
# touched). On by default when an OpenRouter key is present.
# FREE_MODEL_AUTODISCOVERY=1

# Publish-kit trending: default region for daily trending hashtags (US, IN,
# GB, BD, ...). Users can pick per clip in the app. Trends refresh daily.
# PUBLISH_KIT_REGION=US

# Cap for transcripts sent to the summary feature (chars).
# SUMMARY_MAX_CHARS=24000
