# ---------------------------------------------------------------------------
# LLM Providers: Multi-provider fallback for clip detection
# ---------------------------------------------------------------------------
# Configure API keys for the providers you want to use. Fallback order is
# configurable via LLM_FALLBACK_ORDER (default: gemini,claude,deepseek,openai,grok,bedrock-nova).
# Only set API keys for providers you want to enable.

# Google Gemini (free, highly recommended)
# GEMINI_API_KEY=your_google_gemini_api_key_here

# Anthropic Claude (cost-effective fallback)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (gpt-4o-mini is cheapest for reasoning)
# OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek (extremely cheap option, ~$0.14/$0.28 per 1M tokens)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Grok / xAI (fallback option)
# XAI_API_KEY=your_xai_grok_api_key_here

# Amazon Bedrock (use AWS credentials from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
# AWS_REGION for Bedrock defaults to us-east-1 if not set above

# Custom LLM provider order (comma-separated, default: gemini,claude,deepseek,openai,grok,bedrock-nova)
# LLM_FALLBACK_ORDER=gemini,claude,deepseek,openai,grok,bedrock-nova

# ---------------------------------------------------------------------------
# AWS S3 (optional — for clip backup/gallery)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Prod GPU: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Transcription backend: whisper (default) | parakeet. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264

# Product analytics (optional, off by default). Both are read by the dashboard
# at BUILD time. Leave them unset and the frontend initialises no analytics and
# loads no third-party script. Set them to your own OpenPanel instance — and add
# your hostname to ANALYTICS_HOSTS in dashboard/index.html — to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# Thumbnail Studio: creative text model (titles, concepts) and the image model.
# Not tied to GEMINI_MODEL on purpose: flash-lite is fine for closed choices,
# visibly worse at titles.
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Moment picker on your own model instead of Gemini (self-host). Any
# OpenAI-compatible chat endpoint: Ollama, LM Studio, vLLM, llama.cpp,
# LocalAI, OpenRouter. With this set the Gemini key is optional; it is still
# used, if present, for the frame-based stages (layout picker, silent videos).
# Ollama needs a context above its 4096 default: OLLAMA_CONTEXT_LENGTH=16384.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_SCORE_BATCH=3
# LLM_TIMEOUT=600

# Hard daily ceiling for the per-GB paid proxy (UTC day, MB). Above it,
# DataImpulse is removed from every chain until midnight and the jobs that
# needed it fail with a clear error. 0 disables the cap. Default 500.
# PAID_PROXY_DAILY_MB=500

# ---------------------------------------------------------------------------
# Privacy, retention and access control (GDPR remediation, 4-sep-2026)
# ---------------------------------------------------------------------------

# Absolute base URL of the API as the internet reaches it. Already used for the
# absolute clip URLs in webhook payloads; now also required to build the
# unsubscribe link that goes in the out-of-minutes email. Without it that email
# falls back to "reply to unsubscribe".
# PUBLIC_API_URL=https://api.openshorts.app

# /videos and /thumbnails are authenticated endpoints, not static mounts.
# MEDIA_TOKEN_TTL_SECONDS: life of the per-user token the dashboard appends to
#   <video src> / <img src> URLs (default 43200 = 12 h).
# MEDIA_URL_TTL_SECONDS: life of the path-signed capability handed to consumers
#   that cannot send a header — webhook payloads and MCP tool results
#   (default 86400 = 24 h).
# MEDIA_TOKEN_TTL_SECONDS=43200
# MEDIA_URL_TTL_SECONDS=86400

# Retention for the two kinds of file that had none. Thumbnails and the frames
# sampled to make them are close-ups of a real person; the clock runs from the
# last download. Uploaded actor photos die with the job that used them.
# THUMBNAIL_RETENTION_SECONDS=86400
# ACTOR_UPLOAD_RETENTION_SECONDS=3600

# Per-IP rate limiting (rate_limit.py). "<max requests>/<window seconds>".
# Defaults: auth 30/600, process 60/3600, mcp 240/60. Set RATE_LIMIT_ENABLED=0
# to turn the whole thing off (self-host behind your own firewall).
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_AUTH=30/600
# RATE_LIMIT_PROCESS=60/3600
# RATE_LIMIT_MCP=240/60

# Which hop may declare the client's address in X-Forwarded-For. The Dockerfile
# defaults to the private Docker ranges; narrow it to Traefik's own address on
# the container network in production. NEVER "*": that lets any caller forge
# the IP the rate limiter and the rights declaration are keyed on.
# FORWARDED_ALLOW_IPS=10.0.1.7

# Strict-Transport-Security value sent on https responses from the API. Empty
# disables it. Do not add "preload" without understanding that it is one-way.
# HSTS_HEADER=max-age=31536000; includeSubDomains

# Encrypted PostgreSQL backups (ops/pg_backup.sh — installed and scheduled on
# the database host, not by the app). The privacy policy promises a deletion is
# gone from every copy within 30 days, which is only true while this runs.
# DATABASE_URL=postgres://user:pass@host:5432/openshorts
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_DEST=s3://openshorts-backups/pg
# BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# RETENTION_DAYS=30

# Lifecycle emails (cloud/lifecycle.py, cloud mode only): welcome, a nudge a
# day after sign-up with nothing clipped, a win-back 2 days after the first
# free video, and the abandoned-checkout recovery link. The win-back carries
# a Stripe promotion code when one is set here (never commit the real code:
# this repository is public). LIFECYCLE_EMAILS_DISABLED=1 turns all four off.
# WINBACK_PROMO_CODE=
# WINBACK_PROMO_LABEL=50% off your first month
# LIFECYCLE_EMAILS_DISABLED=0
