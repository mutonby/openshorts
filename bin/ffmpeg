#!/bin/sh
# Thread cap for every ffmpeg the app starts (the image puts bin/ first on
# PATH). Left alone, each ffmpeg sizes its decoder and filter pools to the
# machine (~one thread per core), and a job runs several of them per clip, so
# a host busy with a few jobs carries more runnable threads than cores.
#
# FFMPEG_THREADS=N adds "-threads N" before every input that does not set its
# own (decoder threads only: encoders take -threads as an OUTPUT option, which
# this never touches) and -filter_threads / -filter_complex_threads N unless
# the caller set them. Decoding and filtering are deterministic, so the output
# is byte-identical to an uncapped run. Unset, 0 or not a number: ffmpeg runs
# exactly as called.
#
# NVENC_SLOTS=N (set by the API for job processes only, app.run_job) caps how
# many job ffmpegs encode with *_nvenc at once, host-wide. The card's NVENC
# engines are saturated by a few encodes; more sessions only split them, and
# slow down every other encoder sharing the card. An encode takes one of N
# flock files in NVENC_LOCK_DIR before it starts and keeps it on fd 9 for its
# whole life (a dead process releases it). Exempt: encoders fed by a pipe,
# which are paced by the Python writing the frames. After NVENC_SLOT_WAIT
# seconds (600) without a slot it runs anyway, so the cap can delay an encode,
# never stall it. Unset, 0, no flock or no lock dir: no cap.
REAL_FFMPEG=${FFMPEG_REAL_BIN:-/usr/bin/ffmpeg}

slots=${NVENC_SLOTS:-0}
case $slots in ''|*[!0-9]*) slots=0 ;; esac
lock_dir=${NVENC_LOCK_DIR:-}
if [ "$slots" -gt 0 ] && [ -d "$lock_dir" ] && [ -w "$lock_dir" ] \
        && command -v flock >/dev/null 2>&1; then
    encodes=0
    piped=0
    prev=
    for a in "$@"; do
        case $a in *_nvenc) encodes=1 ;; esac
        if [ "$prev" = -i ]; then
            case $a in -|pipe:*) piped=1 ;; esac
        fi
        prev=$a
    done
    if [ "$encodes" = 1 ] && [ "$piped" = 0 ]; then
        max_wait=${NVENC_SLOT_WAIT:-600}
        case $max_wait in ''|*[!0-9]*) max_wait=600 ;; esac
        waited=0
        held=0
        while [ "$held" = 0 ] && [ "$waited" -le "$max_wait" ]; do
            i=0
            while [ "$i" -lt "$slots" ]; do
                lock=$lock_dir/.nvenc-$i.lock
                # `command` keeps a failed open from exiting the shell.
                if { [ ! -e "$lock" ] || [ -w "$lock" ]; } && command exec 9>>"$lock"; then
                    if flock -n 9; then
                        held=1
                        break
                    fi
                    exec 9>&-
                fi
                i=$((i + 1))
            done
            if [ "$held" = 0 ]; then
                sleep 1
                waited=$((waited + 1))
            fi
        done
        # NVENC_WAIT_LOG (main.py sets it per job): one line per encode that
        # waited, its seconds, summed into the job's JOB_CPU line.
        if [ "$waited" -gt 0 ] && [ -n "${NVENC_WAIT_LOG:-}" ]; then
            echo "$waited" >> "$NVENC_WAIT_LOG" 2>/dev/null || true
        fi
    fi
fi

n=${FFMPEG_THREADS:-0}
case $n in
    ''|0|*[!0-9]*) exec "$REAL_FFMPEG" "$@" ;;
esac

has_ft=0
has_fct=0
for a in "$@"; do
    case $a in
        -filter_threads) has_ft=1 ;;
        -filter_complex_threads) has_fct=1 ;;
    esac
done

# Rebuild the argument list in place: take each argument off the front and
# append it (plus "-threads N" ahead of an -i that has none) to the back.
count=$#
seen_threads=0
i=0
while [ "$i" -lt "$count" ]; do
    a=$1
    shift
    i=$((i + 1))
    case $a in
        -threads) seen_threads=1 ;;
        -i)
            [ "$seen_threads" = 1 ] || set -- "$@" -threads "$n"
            seen_threads=0
            ;;
    esac
    set -- "$@" "$a"
done
[ "$has_fct" = 1 ] || set -- -filter_complex_threads "$n" "$@"
[ "$has_ft" = 1 ] || set -- -filter_threads "$n" "$@"
exec "$REAL_FFMPEG" "$@"
